# Copy to /opt/mureforge-webclient/.env on the web client VPS. Read by compose.yml only.

# Images built by .github/workflows/reforge-images.yml. Pin a sha tag in production, so a
# rollback is "put the previous tag back" and a stray CI run never changes what is live.
#   ghcr.io/plugaruroman/mu-reforge-client-web/web:sha-<40 hex>
#   ghcr.io/plugaruroman/mu-reforge-client-web/proxy:sha-<40 hex>
WEB_IMAGE=ghcr.io/plugaruroman/mu-reforge-client-web/web:sha-CHANGEME
PROXY_IMAGE=ghcr.io/plugaruroman/mu-reforge-client-web/proxy:sha-CHANGEME

# Loopback ports the host nginx proxies to (nginx/host/*.conf use these numbers). Check they are
# free first: ss -ltnp | grep -E ':(8730|8731)\b'
WEB_PORT=8731
PROXY_PORT=8730

# Resource caps (compose.yml defaults fit a 4 vCPU / 8 GB box). Raise PROXY_* with the box, never
# above what the box has: a memory kill of the proxy drops every web player at once.
#WEB_CPUS=1.5
#WEB_MEM=512m
#PROXY_CPUS=2
#PROXY_MEM=1g
