# Copy to /opt/mureforge-webclient/proxy.env on the web client VPS. Read by the proxy container
# (proxy/main.ts, proxy/presence.ts, proxy/serverManifest.ts). Changing it takes
# `docker compose up -d proxy`, which disconnects every web player - announce it first.

# --- The relay pin: target aliases (proxy/targetAliases.ts). The ONLY thing between the public
# websocket and every TCP service this box can reach. `alias=host:port`, comma separated.
# The browser only ever names an alias (`?host=cs&port=0`); a raw host:port is refused, and the
# proxy rewrites our addresses in the stream to these names (proxy/addressRewrite.ts:
# ConnectionInfo C1 F4 03 from the connect server, ChatRoomConnectionInfo C3 CA from the game
# server), so no IP or port of ours ever reaches a browser. Must hold:
#   - cs: Molten's connect server for the Open Source client (44406) - serverlist.md publishes
#     the world as `cs@wss://ws.mureforge.com`;
#   - the Open Source endpoint of every game server of every realm the connect server lists, BY
#     THE IP THE CONNECT SERVER HANDS OUT (Molten 169.58.146.212, Inferno 169.58.207.145): the
#     rewrite looks the advertised ip:port up here, and one it does not find goes to the browser
#     as `unlisted` (refused - the player cannot enter that server; the proxy log says
#     `rewrite ...: <ip:port> is not in PROXY_TARGETS`);
#   - chat / chat-inferno: the chat server of BOTH realms on 55980 (PROXY_CHAT_PORT, fixed in the
#     client: chatRoomProtocol.ts) - friend chat rooms and the messenger dial the server it names.
# Names: a lowercase letter, then letters, digits or -, at most 15 characters (the packets' string
# fields), no dots; `unlisted` is reserved. One name per address, one address per name.
# The Open Source ports are NOT guessed here: the server hands them out in an order nobody can
# predict, so read them per realm with the SQL in runbook.md (S2 for Molten, S7 for Inferno) and
# replace every CHANGEME. The proxy REFUSES TO START while one is left, or on any malformed entry.
PROXY_TARGETS=cs=169.58.146.212:44406,molten-1=169.58.146.212:CHANGEME_MOLTEN_OS_PORT_1,molten-2=169.58.146.212:CHANGEME_MOLTEN_OS_PORT_2,molten-3=169.58.146.212:CHANGEME_MOLTEN_OS_PORT_3,inferno-1=169.58.207.145:CHANGEME_INFERNO_OS_PORT_1,inferno-2=169.58.207.145:CHANGEME_INFERNO_OS_PORT_2,inferno-3=169.58.207.145:CHANGEME_INFERNO_OS_PORT_3,chat=169.58.146.212:55980,chat-inferno=169.58.207.145:55980
# PROXY_CHAT_PORT=55980

# ALLOW_TARGETS is the upstream pin (the browser names host:port itself and sees every address).
# It is NOT consulted while PROXY_TARGETS is set; leave it unset. Only for a rollback to the old
# `play.mureforge.com:44406@wss://ws.mureforge.com` world line: comment PROXY_TARGETS out and set
#   ALLOW_TARGETS=play.mureforge.com:44406,169.58.146.212:44406,169.58.146.212:<os ports>,169.58.207.145:<os ports>,169.58.146.212:55980,169.58.207.145:55980

# --- Abuse limits (proxy/relayLimits.ts). The defaults are the production values; set one here
# only to change it, and redo the memory sum in compose.yml (PROXY_MEM) for the buffer/socket ones.
#   WS_MAX_PAYLOAD=16384          largest browser frame (the biggest real packet, a letter, is ~1.5 KB)
#   WS_BACKPRESSURE_LIMIT=524288  bytes held for a browser that does not read; then it is closed
#   TCP_QUEUE_LIMIT=262144        bytes queued for a game server that does not read; then both close
#   PRE_OPEN_LIMIT=16384          bytes a browser may send before the game socket is open
#   CLIENT_MSG_RATE=60            frames/s per websocket (CLIENT_MSG_BURST=200); 0 = off
#   CLIENT_BYTE_RATE=32768        bytes/s per websocket (CLIENT_BYTE_BURST=65536); 0 = off
#   MAX_SOCKETS_PER_IP=30         = nginx limit_conn mu_ws_conn (429 past it)
#   MAX_SOCKETS_TOTAL=2000        = nginx limit_conn mu_ws_total (503 past it)
# A rate-limit close is logged as `rate limit ip=...` (code 1008); grep for it during the beta
# before tightening anything, and raise a value rather than turn it off if real players hit it.
# TRUSTED_PROXIES (whose X-Real-IP is believed) is the image default: loopback + the compose
# network's gateway 172.31.250.1. Override it only together with compose.yml's subnet.

# --- Listener (inside the container; compose publishes it on 127.0.0.1 only).
PORT=3000
HOSTNAME=0.0.0.0

# --- Real client address to the game server (PROXY protocol v2 header as the first bytes of
# every TCP connection the proxy opens). OFF until BOTH realms run the server release that reads
# it AND list WEB_VPS_IP in Configuration -> System -> Trusted Proxies (runbook.md, S11). A game
# server that does not expect the header reads it as a broken packet and drops the player, and one
# that trusts this box requires it - so: server release on Molten and Inferno -> Require Launcher
# "Exempt Web Sessions" on -> in ONE quiet window: Trusted Proxies = WEB_VPS_IP on both panels,
# then PROXY_PROTOCOL=v2 here + `docker compose up -d proxy` (disconnects every web player).
# The address sent is nginx's X-Real-IP (nginx/host/ws.mureforge.com.conf sets it from the TCP
# peer); proxy.Dockerfile holds this knob's default and the proxy's other limits.
PROXY_PROTOCOL=off

# --- Off on a public proxy. Each of these is a dev seam or a privacy problem here:
# LOG_PACKETS: a hex dump of every frame (logins included) in docker logs.
LOG_PACKETS=off
# TRACK: decodes every session and keeps a journal + a GM stream on /admin/stream. We have our own
# admin panel; the journal would hold chats and whispers of every web player.
TRACK=off
TRACK_DB_PATH=memory
ADMIN_OPEN=off
ADMIN_DEMO=off
# BAND: instrument frames are C1 .. FA - the code our server uses for Item Collections.
# With BAND=off the proxy passes client C1 xx FA frames to the game server (proxy/clientFrames.ts),
# which the web client's Item Collections window needs. Keep it off for Mu Reforge.
BAND=off
# PING: map pings are C1 .. FB (unused by our server); off with TRACK anyway.
PING=off
# PRESENCE: the cash shop's "who is online" sniffer. It decrypts every login to learn account
# names. We run no Babylon cash shop, so it stays off; if it is ever turned on it must keep
# listening on loopback (inside the container - compose never publishes it).
PRESENCE=off
PRESENCE_HOST=127.0.0.1
PRESENCE_PORT=3001

# --- Weather: the proxy synthesises a rain/clear frame (OpenMU never sends one). Cosmetic only.
WEATHER=on

# --- server.json (proxy/serverManifest.ts): the world's settings the client fetches from
# https://ws.mureforge.com/server.json. Everything stays at the original client's behaviour.
# marketplace: Babylon's escrow uses C1 E7 01 = our anti-cheat GuardDetectionReport.
MU_MODULES_OFF=marketplace
MU_HELD_HIT_REQUEST=off
MU_RETRY_LOGIN_WHEN_CONNECTED=off
MU_HELPER_AFTER_RECONNECT=off
MU_AUTO_MANA_POTION=off
MU_AUTO_QUIVER=off
MU_REST_ANY_WALL=off
MU_JEWELRY_UPGRADE=off
MU_JEWEL_BUNDLING=off
MU_LITE_ASSETS=off
